{
  "name": "node-apis",
  "version": "4.0.0",
  "description": "Framework-agnostic TypeScript module generator. Turns a typePayload into types, Zod validators, handlers and repositories with one consistent { data, error } shape.",
  "main": "dist/index.js",
  "bin": {
    "node-apis": "./bin/cli.js",
    "napis": "./bin/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node bin/cli.js",
    "format": "prettier --write \"src/**/*.ts\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{js,json,md}\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "code-generator",
    "typescript",
    "nodejs",
    "cli",
    "module-generator",
    "framework-agnostic",
    "crud",
    "clean-architecture",
    "type-driven",
    "zod",
    "validation",
    "handlers",
    "repository",
    "monorepo"
  ],
  "author": {
    "name": "Sobebar Ali",
    "email": "sobebar.ali17@gmail.com",
    "url": "https://sobebar.online"
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "fs-extra": "^11.1.1",
    "inquirer": "^9.2.12"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sobebarali/node-apis.git"
  },
  "bugs": {
    "url": "https://github.com/sobebarali/node-apis/issues"
  },
  "homepage": "https://github.com/sobebarali/node-apis#readme",
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^24.3.1",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
